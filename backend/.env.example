# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed by CORS (use real domains in production; "*" is rejected in production)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Set true behind a reverse proxy / load balancer (needed for correct client IPs in rate limiting)
TRUST_PROXY=false
LOG_LEVEL=info

# ---- MongoDB ----
MONGODB_URI=mongodb://127.0.0.1:27017/tictactoe

# ---- Redis (optional: Socket.IO adapter for horizontal scaling) ----
REDIS_URL=

# ---- JWT (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ----
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
GUEST_REFRESH_TOKEN_TTL_DAYS=90

# ---- Password hashing ----
BCRYPT_ROUNDS=12

# ---- Social login ----
# Comma-separated OAuth client IDs accepted as audience for Google ID tokens
GOOGLE_CLIENT_IDS=
# Apple bundle ID / service ID accepted as audience
APPLE_CLIENT_ID=

# ---- Email (optional; without SMTP_HOST emails are only logged outside production) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Tic Tac Toe <no-reply@example.com>
# Base URL used in verification / reset links (web page or deep link)
APP_BASE_URL=https://app.example.com

# ---- Firebase Cloud Messaging (optional) ----
# Path to a service-account JSON file, or the JSON itself on one line
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- Rate limits ----
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
SOCKET_EVENTS_PER_SEC=20

# ---- Gameplay ----
TURN_TIMEOUT_SEC=60
DISCONNECT_GRACE_SEC=30
MATCH_QUEUE_TTL_SEC=120
ROOM_TTL_MIN=30
