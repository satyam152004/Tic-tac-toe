{
  "name": "tictactoe-backend",
  "version": "1.0.0",
  "description": "Production-oriented Tic Tac Toe backend (Express, MongoDB, Socket.IO, JWT)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:api": "tsx scripts/generate-api-docs.ts",
    "dev:mongo": "tsx scripts/dev-mongo.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.4",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.10",
    "nodemailer": "^10.6.0",
    "pino": "^10.4.0",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "type": "module"
}
