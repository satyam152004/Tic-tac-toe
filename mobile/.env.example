# Copy to .env (git-ignored). Only PUBLIC identifiers belong here: never secrets, tokens or private keys.

# Backend base URL (no trailing slash, no /api/v1). Release builds require https://.
#   Android emulator -> http://10.0.2.2:4000     iOS simulator -> http://localhost:4000
#   Physical device  -> http://<your-LAN-IP>:4000 (development builds only)
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Google sign-in (optional). The backend must be configured with the SAME web client id.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reversed iOS client id (config plugin input at prebuild time), e.g. com.googleusercontent.apps.1234-abcd
GOOGLE_IOS_URL_SCHEME=

# Host for https invitation links (https://<host>/join/ABC234). Optional; custom scheme tictactoe:// always works.
EXPO_PUBLIC_LINK_HOST=

# Application ids
IOS_BUNDLE_ID=com.tictactoe.game
ANDROID_PACKAGE=com.tictactoe.game
